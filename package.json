{
  "name": "universidade-livre-desktop",
  "version": "1.2.1",
  "private": true,
  "description": "Aplicativo desktop multiplataforma da Universidade Livre",
  "author": "Leandro Stanger",
  "homepage": "https://leandrostanger.github.io/UniversidadeLivre/",
  "desktopName": "io.github.leandrostanger.universidadelivre",
  "main": "desktop/main.cjs",
  "scripts": {
    "prestart": "npm run build:iconify-icons && npm run build:desktop-player && node desktop/download-yt-dlp.cjs",
    "start": "electron .",
    "predist": "npm run build:iconify-icons && npm run build:desktop-player && node desktop/download-yt-dlp.cjs",
    "dist": "electron-builder --publish never",
    "build:desktop-player": "node desktop/build-videojs-v10.cjs",
    "build:iconify-icons": "node desktop/build-iconify-icons.cjs"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.546",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.leandrostanger.universidadelivre",
    "productName": "Universidade Livre",
    "asar": true,
    "files": [
      "index.html",
      "style.css",
      "script.js",
      "auditorio/**/*",
      "base/**/*",
      "biblioteca/**/*",
      "comunidade/**/*",
      "cursos/**/*",
      "notas/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/offline-downloads.cjs",
      "desktop/static-server.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/bin/yt-dlp/${os}-${arch}",
        "to": "yt-dlp",
        "filter": [
          "yt-dlp*",
          "deno*",
          "LICENSE*",
          "THIRD_PARTY_LICENSES*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "appImage": {
      "artifactName": "Universidade_Livre-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "executableName": "io.github.leandrostanger.universidadelivre",
      "icon": "packaging/flatpak/io.github.leandrostanger.universidadelivre.png",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Icon": "io.github.leandrostanger.universidadelivre"
        }
      },
      "category": "Education",
      "maintainer": "Universidade Livre",
      "target": [
        "AppImage",
        "pacman"
      ]
    },
    "pacman": {
      "depends": [
        "c-ares",
        "ffmpeg",
        "gtk3",
        "libevent",
        "libvpx",
        "libxslt",
        "libxss",
        "minizip",
        "nss",
        "re2",
        "snappy",
        "libnotify",
        "libappindicator"
      ]
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@videojs/google-cast": "10.1.0",
    "@videojs/html": "10.1.0",
    "@videojs/youtube-video": "10.1.0"
  }
}
